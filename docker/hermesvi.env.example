# ---- HermesVI ---------------------------------------------------
# Anzeigename deines Agenten in der Oberfläche
AGENT_NAME=Hermes

# Hermes API-Server deines Agenten-Profils (siehe README Schritt 1)
# Docker: IP der Hermes-VM im internen Netz statt 127.0.0.1
HERMES_URL=http://192.168.1.50:8642
HERMES_KEY=hier-den-API_SERVER_KEY-eintragen
# responses = Verlauf liegt in Hermes (empfohlen) | chat = Fallback
HERMES_MODE=responses
HERMES_CONVERSATION=hermesvi
# Gedächtnis-Scope in Hermes (leer = wie HERMES_CONVERSATION)
HERMES_SESSION_KEY=

# Spracherkennung: elevenlabs = Scribe (schnell, gleicher Key wie die Stimme)
#                  local = Whisper im Container (privat, aber langsamer auf CPU) | hermes = Plugin
STT_BACKEND=elevenlabs
ELEVENLABS_STT_MODEL=scribe_v2
# Nachdenk-Stufe für Sprachgespräche: none | minimal | low | medium | high | leer = wie in Hermes
HERMES_REASONING=low
WHISPER_MODEL=small
WHISPER_THREADS=4

# Nur für STT_BACKEND/TTS_BACKEND=hermes: hermes-audio-api Plugin (Port 8643)
AUDIO_URL=http://192.168.1.50:8643
AUDIO_KEY=
# Stimme: elevenlabs = dieselbe Stimme wie in Hermes | edge = kostenlose Microsoft-Stimme | hermes = Plugin | browser = Gerät
TTS_BACKEND=elevenlabs
# Werte aus ~/.hermes/.env des Agenten (ELEVENLABS_API_KEY) und config.yaml (tts.elevenlabs.voice_id / model_id)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=pNInz6obpgDQGcFmaJgB
ELEVENLABS_MODEL_ID=eleven_flash_v2_5
EDGE_VOICE=de-DE-ConradNeural
STT_LANGUAGE=de

# Zusatzhinweis an den Agenten für Sprachgespräche (leer lassen, wenn er sonst seine Persönlichkeit verliert)
VOICE_HINT=Du sprichst gerade per Sprache. Antworte kurz, natürlich und gesprochen – keine Markdown-Listen, keine Codeblöcke, keine Emojis.

# Optionaler Passwortschutz (Benutzername egal)
APP_PASSWORD=

# HOST/PORT setzt docker-compose selbst
HOST=127.0.0.1
PORT=8800

# Aufträge + Log links im Dashboard: direkt aus dem Hermes-Dashboard (Weboberfläche)
# URL so, wie der Docker-Host das Dashboard erreicht (Standard-Port 9119)
HERMES_DASHBOARD_URL=http://192.168.1.50:9119
# = HERMES_DASHBOARD_SESSION_TOKEN auf der Hermes-VM (python3 -c "import secrets;print(secrets.token_urlsafe(32))")
HERMES_DASHBOARD_TOKEN=
DASHBOARD_INTERVAL=15
# welches Log: gateway | agent | errors   (leer = kein Log)
LOG_NAME=gateway
LOG_LINES=80
# Der Agent meldet sich von selbst, wenn ein Auftrag diesen Status bekommt (leer = nie)
NOTIFY_STATUSES=done,failed,blocked
# nur diese Agenten (leer = alle), z. B. emilia,research
NOTIFY_ASSIGNEES=
