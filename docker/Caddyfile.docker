# Variante A – nur im NetBird-Netz mit Caddy-eigenem Zertifikat.
# Hostname/IP = NetBird-Name bzw. NetBird-IP des Docker-Hosts.
# Root-Zertifikat für Handy/PC: docker compose cp caddy:/data/caddy/pki/authorities/local/root.crt ./caddy-root.crt
hermesvi.netbird.local, 100.64.0.20 {
    tls internal
    header Strict-Transport-Security "max-age=31536000"
    reverse_proxy hermesvi:8800 {
        flush_interval -1
    }
}

# Variante B – eigene Subdomain mit DNS-Challenge (Caddy-Image mit DNS-Plugin nötig, z. B. eigenes Build mit xcaddy)
# hermesvi.deine-domain.de {
#     tls { dns cloudflare {env.CF_API_TOKEN} }
#     reverse_proxy hermesvi:8800 { flush_interval -1 }
# }
